# Copy this file to .env. Everything is optional for the sample-data run.

# Turn on a real LLM. Use provider:model and set that provider's key.
# LLM_MODEL=openai:your-model-name
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Langfuse traces
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# auto, demo, local or bigquery
# DATA_BACKEND=auto
# BQ_DATASET=datapilot
